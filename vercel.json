{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'No build step for FastAPI API'",
  "outputDirectory": ".",
  "installCommand": "pip install -r requirements.txt --quiet",
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["iad1"],
  "env": {
    "QB_GATEWAY_SECRET": "@qb_gateway_secret",
    "AI_MODE_ENABLED": "false",
    "PROTOCOL_VERSION": "2"
  },
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py",
      "continue": true
    }
  ],
  "redirects": [
    {
      "source": "/health",
      "destination": "/api/health",
      "permanent": false
    },
    {
      "source": "/status",
      "destination": "/api/status",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/api/docs",
      "permanent": false
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi.json",
      "permanent": false
    }
  ]
}
