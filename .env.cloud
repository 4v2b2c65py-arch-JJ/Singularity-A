# Cloud Model Configuration
# Set your cloud model endpoint and API key here

# Your custom cloud model endpoint
CLOUD_MODEL_ENDPOINT="https://your-cloud-model-endpoint.com/api/v1/chat"

# Your API key for the cloud model
CLOUD_MODEL_API_KEY="your-api-key-here"

# Alternative: You can set these as environment variables
# export CLOUD_MODEL_ENDPOINT="https://your-cloud-model-endpoint.com/api/v1/chat"
# export CLOUD_MODEL_API_KEY="your-api-key-here"
